# 복사해서 .env로 저장합니다. .env는 커밋하지 않습니다.
# 기준값: docs/plan/CURRENT_STACK.md

# PostgreSQL (docker-compose.yml)
DB_NAME=storyforge
DB_USER=storyforge
DB_PASSWORD=storyforge
DB_PORT=5433

# storyforge-backend
BACKEND_PORT=8080
DB_URL=jdbc:postgresql://localhost:5433/storyforge
AI_SERVICE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:4200

# storyforge-ai
# mock: API 키 없이 동작하는 개발용 생성기 / anthropic: Claude API 사용
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
