# 복사해서 .env로 저장합니다. .env는 커밋하지 않습니다.
# 기준값: docs/plan/CURRENT_STACK.md

# PostgreSQL (docker-compose.yml)
DB_NAME=storyforge
DB_USER=storyforge
DB_PASSWORD=storyforge
DB_PORT=5433

# storyforge-backend
BACKEND_PORT=8080
DB_URL=jdbc:postgresql://localhost:5433/storyforge
AI_SERVICE_URL=http://localhost:8001
FRONTEND_ORIGIN=http://localhost:4200
CONSOLE_ORIGIN=http://localhost:4201
# 32바이트 이상. 비우면 시작할 때 무작위 생성 (재시작하면 로그인 풀림)
JWT_SECRET=
JWT_TTL=12h
JWT_REFRESH_TTL=14d
# Prometheus /actuator/prometheus. 비우면 404입니다.
METRICS_TOKEN=
# SMTP는 기본 비활성. 로컬 수신기로 검증한 뒤 실제 공급자 값을 설정합니다.
MAIL_ENABLED=false
MAIL_FROM=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_SSL=false
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_GENERATE_PER_MINUTE=30
RATE_LIMIT_COMMUNITY_PER_MINUTE=60
# 관리자 이메일 (쉼표로 구분). 비우면 관리자가 없습니다.
ADMIN_EMAILS=
# 이 주소에서 온 요청만 X-Forwarded-For를 신뢰합니다. 비우면 접속 주소만 사용합니다.
TRUSTED_PROXIES=
# 쉼표로 구분한 금지 표현. 비우면 검사하지 않습니다.
CONTENT_BLOCKLIST=
# 이용약관 버전. 올리면 기존 사용자는 다시 동의해야 게시할 수 있습니다.
TERMS_VERSION=2026-11-04
# 작업 그래프와 활동 잔디의 날짜 기준
COMMUNITY_ZONE=Asia/Seoul
# 가이드챗 콜라보 이동 주소. 비우면 이동 버튼을 표시하지 않습니다.
CODICOMPERCHAT_URL=

# storyforge-ai
# mock: 개발용 / ollama: 로컬 Gemma / anthropic: Claude 기본 라우팅
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_KEEP_ALIVE=15m
OLLAMA_NUM_CTX=32768
OLLAMA_THINK=false
OLLAMA_WARMUP=false
OLLAMA_MAX_CONCURRENT=1
OLLAMA_QUEUE_TIMEOUT=5
OLLAMA_TIMEOUT=180
OLLAMA_STRUCTURED_MAX_TOKENS=8000
OLLAMA_STREAM_MAX_TOKENS=24000
