# 복사해서 .env로 저장합니다. .env는 커밋하지 않습니다.
# 기준값: docs/plan/CURRENT_STACK.md

# PostgreSQL (docker-compose.yml)
DB_NAME=storyforge
DB_USER=storyforge
DB_PASSWORD=storyforge
DB_PORT=5433

# storyforge-backend
BACKEND_PORT=8080
DB_URL=jdbc:postgresql://localhost:5433/storyforge
AI_SERVICE_URL=http://localhost:8001
FRONTEND_ORIGIN=http://localhost:4200
# 32바이트 이상. 개발에서 비우면 시작할 때 무작위 생성 (재시작하면 로그인 풀림). prod 프로필에서는 필수
JWT_SECRET=
JWT_TTL=12h
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_GENERATE_PER_MINUTE=30
RATE_LIMIT_COMMUNITY_PER_MINUTE=60
# 비우면 X-Forwarded-For를 믿지 않습니다. 운영 프록시 주소만 쉼표로 넣습니다.
TRUSTED_PROXIES=
# 금지 표현. 비우면 검사하지 않습니다.
CONTENT_BLOCKLIST=
# 이 이메일은 관리자가 됩니다.
ADMIN_EMAILS=
# 작업 그래프와 활동 잔디의 날짜 기준
COMMUNITY_ZONE=Asia/Seoul
# 가이드챗 콜라보 이동 주소. 비우면 이동 버튼을 표시하지 않습니다.
CODICOMPERCHAT_URL=

# storyforge-ai
# mock: API 키 없이 동작하는 개발용 생성기 / anthropic: Claude API 사용
# 백엔드도 이 값을 읽어 외부 전송 안내를 띄웁니다. 두 프로세스에 같이 넣으세요.
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
